# Copy this file to server/.env for local development.
# On Render, add the same keys under the service's Environment tab.

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# Comma-separated list of allowed browser origins.
# Include your GitHub Pages site and Vercel site.
ALLOWED_ORIGINS=https://neuralshubh.github.io,http://localhost:5173

PORT=4000
